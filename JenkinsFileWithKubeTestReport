
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'sreenivasulusamala108/selenium-tests'
        IMAGE_TAG  = 'v4'
        PATH       = "/usr/local/bin:${env.PATH}"
        K8S_NAMESPACE = 'default'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/sreenivas-shamala/selenium_jenkins_integration.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG .'
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        set -eu
                        echo "$DOCKER_PASS" |
                            docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$IMAGE_NAME:$IMAGE_TAG"
                        docker logout || true
                    '''
                }
            }
        }

        stage('Check kubectl') {
            steps {
                withCredentials([
                    file(credentialsId: 'k8s_config',
                         variable: 'KUBECONFIG')
                ]) {
                    sh '''
                        set -e
                        kubectl version --client
                        kubectl cluster-info
                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Clean Old Reports') {
            steps {
                sh '''
                    rm -rf target/surefire-reports test-output
                    mkdir -p target/surefire-reports test-output
                '''
            }
        }

        stage('Run Selenium Tests') {
            steps {
                withCredentials([
                    file(credentialsId: 'k8s_config',
                         variable: 'KUBECONFIG')
                ]) {
                    sh '''
    set -eu

    NS=default
    JOB=selenium-test

    kubectl delete job "$JOB" -n "$NS" \
        --ignore-not-found=true --wait=true

    kubectl apply -n "$NS" -f selenium-jenkins-app-report.yaml

    echo "Waiting for the Selenium pod..."
    kubectl wait -n "$NS" \
        --for=condition=Ready pod \
        -l job-name="$JOB" \
        --timeout=120s

    POD=$(kubectl get pods -n "$NS" \
        -l job-name="$JOB" \
        -o jsonpath='{.items[0].metadata.name}')

    echo "Waiting for reports to be generated..."

    READY=0
    for i in $(seq 1 300); do
        if kubectl exec -n "$NS" "$POD" \
            -c selenium-test -- \
            test -f /tmp/reports-ready 2>/dev/null; then
            READY=1
            break
        fi

        sleep 2
    done

    if [ "$READY" -ne 1 ]; then
        echo "Reports were not generated before timeout"
        kubectl logs -n "$NS" "$POD" || true
        exit 1
    fi

    mkdir -p target/surefire-reports test-output

    echo "Copying reports while the container is running..."

    kubectl cp -n "$NS" \
        "$POD:/app/target/surefire-reports/." \
        target/surefire-reports/ \
        -c selenium-test

    kubectl cp -n "$NS" \
        "$POD:/app/test-output/." \
        test-output/ \
        -c selenium-test || true

    # Read the test exit code before allowing the container to exit.
    TEST_EXIT=$(kubectl exec -n "$NS" "$POD" \
        -c selenium-test -- cat /tmp/test-exit-code)

    # Allow the container and Kubernetes Job to finish.
    kubectl exec -n "$NS" "$POD" \
        -c selenium-test -- touch /tmp/reports-copied

    if [ "$TEST_EXIT" != "0" ]; then
        echo "Selenium tests failed with exit code $TEST_EXIT"
        exit 1
    fi

    kubectl wait -n "$NS" \
        --for=condition=complete job/"$JOB" \
        --timeout=120s
'''
                }
            }
        }

        stage('Selenium Test Logs') {
            steps {
                withCredentials([
                    file(credentialsId: 'k8s_config',
                         variable: 'KUBECONFIG')
                ]) {
                    sh '''
                        kubectl logs \
                            -n "$K8S_NAMESPACE" \
                            job/selenium-test \
                            --all-containers=true \
                            > selenium-test.log 2>&1 || true

                        cat selenium-test.log
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                withCredentials([
                    file(credentialsId: 'k8s_config',
                         variable: 'KUBECONFIG')
                ]) {
                    sh '''
                        set +e

                        echo "=== Locate Selenium pod ==="

                        POD=$(kubectl get pods \
                            -n "$K8S_NAMESPACE" \
                            -l job-name=selenium-test \
                            -o jsonpath='{.items[0].metadata.name}' \
                            2>/dev/null)

                        if [ -z "$POD" ]; then
                            echo "No Selenium pod found"
                            exit 0
                        fi

                        echo "Pod: $POD"

                        echo "=== Collect TestNG reports ==="

                        # Update /app to the actual project directory
                        # inside your Selenium container.
                        kubectl cp \
                            "$K8S_NAMESPACE/$POD:/app/target/surefire-reports/." \
                            target/surefire-reports/ \
                            -c "$(kubectl get pod "$POD" \
                                -n "$K8S_NAMESPACE" \
                                -o jsonpath='{.spec.containers[0].name}')" \
                            || echo "Could not copy Surefire reports"

                        kubectl cp \
                            "$K8S_NAMESPACE/$POD:/app/test-output/." \
                            test-output/ \
                            -c "$(kubectl get pod "$POD" \
                                -n "$K8S_NAMESPACE" \
                                -o jsonpath='{.spec.containers[0].name}')" \
                            || echo "Could not copy TestNG output"

                        echo "=== XML files in Jenkins workspace ==="
                        find . -type f -name "*.xml" -print

                        echo "=== Screenshots in Jenkins workspace ==="
                        find . -type f -name "*.png" -print
                    '''
                }

                if (fileExists('target/surefire-reports/testng-results.xml')) {
                    testNG(
                        reportFilenamePattern:
                            '**/testng-results.xml',
                        showFailedBuilds: true
                    )
                } else {
                    echo 'TestNG XML is missing from the Jenkins workspace.'
                }

                archiveArtifacts(
                    artifacts: '**/surefire-reports/**/*,**/test-output/**/*,selenium-test.log',
                    allowEmptyArchive: true
                )
            }
        }

        success {
            echo 'Selenium tests passed'
        }

        failure {
            echo 'Selenium tests failed; checking published reports and logs'
        }
    }
}
