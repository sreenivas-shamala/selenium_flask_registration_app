pipeline {

    agent any

    environment {
        IMAGE_NAME = "sreenivasulusamala108/selenium-tests"
        IMAGE_TAG = "v3"
        PATH = "/usr/local/bin:${env.PATH}"
    }

        
    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url:'https://github.com/sreenivas-shamala/selenium_jenkins_integration.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG .'
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {

                    sh '''
                    echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                    docker push $IMAGE_NAME:$IMAGE_TAG
                    '''
                }
            }
        }

       stage('Check kubectl') {
    steps {
        sh '''
            echo "PATH=$PATH"
            which kubectl
            kubectl version --client
        '''
    }
}
        stage('Test Kubernetes') {
    steps {
        withCredentials([
            file(
                credentialsId: 'k8s_config',
                variable: 'KUBECONFIG'
            )
        ]) {
            sh '''
                set -e

                echo "===== kubectl ====="
                which kubectl
                kubectl version --client

                echo "===== KUBECONFIG ====="
                ls -l "$KUBECONFIG"

                echo "===== CONTEXT ====="
                kubectl config current-context

                echo "===== API SERVER ====="
                kubectl config view --minify \
                    -o jsonpath='{.clusters[0].cluster.server}'
                echo

                echo "===== CLUSTER INFO ====="
                kubectl cluster-info

                echo "===== NODES ====="
                kubectl get nodes
            '''
        }
    }
}
             
stage('Clean Old Reports') {
    steps {
        sh 'rm -rf target/surefire-reports test-output'
    }
}        

 stage('Run Selenium Tests') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k8s_config',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -e

            echo "=== Delete previous Selenium Job ==="
            kubectl delete job selenium-test \
                --ignore-not-found=true --wait=true

            echo "=== Start Selenium Job ==="
            kubectl apply -f selenium-jenkins-app.yaml

            echo "=== Wait for Selenium tests ==="
            if kubectl wait \
                --for=condition=complete \
                job/selenium-test \
                --timeout=300s; then
                echo "Selenium tests passed"
            else
                echo "Selenium Job did not complete successfully"
                kubectl describe job selenium-test || true
                kubectl get pods -l job-name=selenium-test
                kubectl logs job/selenium-test --all-containers=true || true
                exit 1
            fi
                    '''
                }
            }
        }

        stage('Selenium Test Logs') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k8s_config',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        echo "=== Selenium Test Logs ==="
            kubectl logs job/selenium-test --all-containers=true
                    '''
                }
            }
        }


    }


    post {

        always {

            echo '=== TestNG Report Publishing ==='

        sh '''
            echo "=== TestNG XML reports ==="
            find target/surefire-reports -type f -name "*.xml" -print
        '''

        testNG(
            reportFilenamePattern: '**/testng-results.xml',
            showFailedBuilds: true
        )

        archiveArtifacts(
            artifacts: 'target/surefire-reports/**/*,test-output/**/*',
            allowEmptyArchive: true
        )
       } 
        success {
            echo 'Selenium tests passed'
        }

        failure {
            echo 'Selenium tests failed'
        }
    }
}
